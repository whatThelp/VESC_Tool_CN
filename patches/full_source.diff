-&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Roboto'; font-style:italic;&quot;&gt;The motor starts to spin, but is too weak to reach enough speed.&lt;/span&gt;&lt;/p&gt;
